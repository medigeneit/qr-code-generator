<template>
    <main class="page">
        <section class="hero">
            <h1>Make a QR code <span class="grad">in seconds.</span></h1>
            <p>Free, private and runs in your browser.</p>
        </section>

        <div class="studio">
            <section class="card editor input" aria-label="Input">
                <h2 class="section-title"><span class="step">1</span>Content</h2>

                <div class="tabs" role="tablist" aria-label="Content type">
                    <button type="button" role="tab" id="tab-url" aria-controls="pane-url" data-type="url" aria-selected="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>URL</button>
                    <button type="button" role="tab" id="tab-text" aria-controls="pane-text" data-type="text" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9"/></svg>Text</button>
                    <button type="button" role="tab" id="tab-wifi" aria-controls="pane-wifi" data-type="wifi" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="0.6"/></svg>Wi-Fi</button>
                    <button type="button" role="tab" id="tab-email" aria-controls="pane-email" data-type="email" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>Email</button>
                    <button type="button" role="tab" id="tab-phone" aria-controls="pane-phone" data-type="phone" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Phone</button>
                    <button type="button" role="tab" id="tab-sms" aria-controls="pane-sms" data-type="sms" aria-selected="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>SMS</button>
                </div>

                <div class="pane" id="pane-url" role="tabpanel" aria-labelledby="tab-url" data-pane="url">
                    <label class="field">
                        <span>Website address</span>
                        <input id="f-url" type="url" inputmode="url" placeholder="https://example.com" autocomplete="off" spellcheck="false">
                    </label>
                </div>

                <div class="pane" id="pane-text" role="tabpanel" aria-labelledby="tab-text" data-pane="text" hidden>
                    <label class="field">
                        <span>Text</span>
                        <textarea id="f-text" rows="4" placeholder="Anything you want to share"></textarea>
                    </label>
                </div>

                <div class="pane" id="pane-wifi" role="tabpanel" aria-labelledby="tab-wifi" data-pane="wifi" hidden>
                    <div class="grid2">
                        <label class="field">
                            <span>Network name (SSID)</span>
                            <input id="f-ssid" type="text" placeholder="Home Wi-Fi" autocomplete="off" spellcheck="false">
                        </label>
                        <label class="field">
                            <span>Password</span>
                            <input id="f-pass" type="text" placeholder="Not saved anywhere" autocomplete="off" spellcheck="false">
                        </label>
                    </div>
                    <div class="grid2">
                        <label class="field">
                            <span>Security</span>
                            <select id="f-sec">
                                <option value="WPA">WPA / WPA2 / WPA3</option>
                                <option value="WEP">WEP</option>
                                <option value="nopass">None</option>
                            </select>
                        </label>
                        <label class="check">
                            <input id="f-hidden" type="checkbox">
                            <span>Hidden network</span>
                        </label>
                    </div>
                </div>

                <div class="pane" id="pane-email" role="tabpanel" aria-labelledby="tab-email" data-pane="email" hidden>
                    <label class="field">
                        <span>Email address</span>
                        <input id="f-email" type="email" inputmode="email" placeholder="hello@example.com" autocomplete="off">
                    </label>
                    <label class="field">
                        <span>Subject <em>optional</em></span>
                        <input id="f-subject" type="text" autocomplete="off">
                    </label>
                    <label class="field">
                        <span>Message <em>optional</em></span>
                        <textarea id="f-body" rows="3"></textarea>
                    </label>
                </div>

                <div class="pane" id="pane-phone" role="tabpanel" aria-labelledby="tab-phone" data-pane="phone" hidden>
                    <label class="field">
                        <span>Phone number</span>
                        <input id="f-phone" type="tel" inputmode="tel" placeholder="+880 1XXX-XXXXXX" autocomplete="off">
                    </label>
                </div>

                <div class="pane" id="pane-sms" role="tabpanel" aria-labelledby="tab-sms" data-pane="sms" hidden>
                    <label class="field">
                        <span>Phone number</span>
                        <input id="f-sms-to" type="tel" inputmode="tel" placeholder="+880 1XXX-XXXXXX" autocomplete="off">
                    </label>
                    <label class="field">
                        <span>Message <em>optional</em></span>
                        <textarea id="f-sms-body" rows="3"></textarea>
                    </label>
                </div>

            </section>

            <section class="card editor settings" aria-label="Style">
                <div class="settings-head">
                    <h2 class="section-title"><span class="step">2</span>Style</h2>
                    <button type="button" class="reset" id="reset">Reset</button>
                </div>

                <div class="field">
                    <span>Color presets</span>
                    <div class="presets" id="presets"></div>
                </div>

                <label class="field">
                    <span>Foreground</span>
                    <span class="color">
                        <input id="f-fg" type="color" value="#111111" aria-label="Foreground color">
                        <input id="f-fg-hex" type="text" value="#111111" maxlength="7" spellcheck="false" aria-label="Foreground hex">
                    </span>
                </label>

                <label class="field">
                    <span>Background</span>
                    <span class="color">
                        <input id="f-bg" type="color" value="#ffffff" aria-label="Background color">
                        <input id="f-bg-hex" type="text" value="#ffffff" maxlength="7" spellcheck="false" aria-label="Background hex">
                    </span>
                </label>

                <div class="field">
                    <span>Dot style</span>
                    <div class="seg" id="f-style" role="radiogroup" aria-label="Dot style">
                        <button type="button" role="radio" data-v="square">Square</button>
                        <button type="button" role="radio" data-v="rounded">Rounded</button>
                        <button type="button" role="radio" data-v="dots">Dots</button>
                    </div>
                </div>

                <div class="field">
                    <span>Logo <em id="logo-hint">uses level H</em></span>
                    <div class="logo-row">
                        <span class="logo-thumb" aria-hidden="true">
                            <img id="logo-img" alt="" hidden>
                            <svg viewBox="0 0 24 24" id="logo-placeholder"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><circle cx="9" cy="9" r="1.6"/><path d="m4 17 5-5 4 4 2.5-2.5L20 17"/></svg>
                        </span>
                        <span class="logo-name" id="logo-name">No logo</span>
                        <button type="button" class="reset" id="logo-pick">Upload</button>
                        <button type="button" class="reset" id="logo-remove" hidden>Remove</button>
                        <input id="f-logo" type="file" accept="image/*" hidden>
                    </div>
                </div>

                <details class="advanced">
                    <summary>Advanced</summary>
                    <div class="advanced-body">
                        <div class="field">
                            <span>Error correction <em id="ecc-hint"></em></span>
                            <div class="seg" id="f-ecc" role="radiogroup" aria-label="Error correction">
                                <button type="button" role="radio" data-v="L">L</button>
                                <button type="button" role="radio" data-v="M">M</button>
                                <button type="button" role="radio" data-v="Q">Q</button>
                                <button type="button" role="radio" data-v="H">H</button>
                            </div>
                        </div>
                        <label class="field">
                            <span>Quiet zone <em id="margin-val"></em></span>
                            <input id="f-margin" type="range" min="0" max="8" step="1" value="2">
                        </label>
                    </div>
                </details>
            </section>

            <aside class="card preview output" aria-labelledby="download-title">
                <div class="preview-main">
                    <div class="preview-sticky">
                        <h2 class="section-title" id="download-title"><span class="step">3</span>Download</h2>
                        <div class="frame">
                            <canvas id="qr" width="640" height="640" role="img" aria-label="QR code preview"></canvas>
                            <div class="empty" id="empty" hidden>
                                <svg class="sample" viewBox="0 0 25 25" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h7v1h-7zM8 0h5v1h-5zM14 0h2v1h-2zM18 0h7v1h-7zM0 1h1v1h-1zM6 1h1v1h-1zM8 1h3v1h-3zM12 1h2v1h-2zM15 1h2v1h-2zM18 1h1v1h-1zM24 1h1v1h-1zM0 2h1v1h-1zM2 2h3v1h-3zM6 2h1v1h-1zM11 2h1v1h-1zM15 2h1v1h-1zM18 2h1v1h-1zM20 2h3v1h-3zM24 2h1v1h-1zM0 3h1v1h-1zM2 3h3v1h-3zM6 3h1v1h-1zM9 3h3v1h-3zM13 3h2v1h-2zM18 3h1v1h-1zM20 3h3v1h-3zM24 3h1v1h-1zM0 4h1v1h-1zM2 4h3v1h-3zM6 4h1v1h-1zM8 4h1v1h-1zM15 4h1v1h-1zM18 4h1v1h-1zM20 4h3v1h-3zM24 4h1v1h-1zM0 5h1v1h-1zM6 5h1v1h-1zM8 5h2v1h-2zM12 5h5v1h-5zM18 5h1v1h-1zM24 5h1v1h-1zM0 6h7v1h-7zM8 6h1v1h-1zM10 6h1v1h-1zM12 6h1v1h-1zM14 6h1v1h-1zM16 6h1v1h-1zM18 6h7v1h-7zM10 7h1v1h-1zM14 7h3v1h-3zM0 8h1v1h-1zM5 8h2v1h-2zM8 8h1v1h-1zM11 8h2v1h-2zM15 8h3v1h-3zM20 8h1v1h-1zM24 8h1v1h-1zM1 9h2v1h-2zM7 9h1v1h-1zM10 9h4v1h-4zM15 9h3v1h-3zM19 9h2v1h-2zM23 9h1v1h-1zM3 10h4v1h-4zM8 10h2v1h-2zM12 10h1v1h-1zM16 10h1v1h-1zM18 10h2v1h-2zM0 11h1v1h-1zM5 11h1v1h-1zM7 11h1v1h-1zM12 11h1v1h-1zM16 11h6v1h-6zM0 12h1v1h-1zM3 12h1v1h-1zM6 12h1v1h-1zM8 12h1v1h-1zM12 12h2v1h-2zM15 12h3v1h-3zM19 12h1v1h-1zM21 12h3v1h-3zM1 13h1v1h-1zM5 13h1v1h-1zM7 13h1v1h-1zM9 13h3v1h-3zM14 13h2v1h-2zM19 13h2v1h-2zM22 13h2v1h-2zM2 14h1v1h-1zM4 14h1v1h-1zM6 14h2v1h-2zM10 14h2v1h-2zM13 14h7v1h-7zM21 14h1v1h-1zM23 14h2v1h-2zM0 15h3v1h-3zM5 15h1v1h-1zM8 15h1v1h-1zM10 15h1v1h-1zM13 15h1v1h-1zM17 15h1v1h-1zM21 15h4v1h-4zM0 16h1v1h-1zM2 16h3v1h-3zM6 16h1v1h-1zM8 16h7v1h-7zM16 16h9v1h-9zM8 17h3v1h-3zM16 17h1v1h-1zM20 17h1v1h-1zM23 17h1v1h-1zM0 18h7v1h-7zM14 18h3v1h-3zM18 18h1v1h-1zM20 18h1v1h-1zM0 19h1v1h-1zM6 19h1v1h-1zM8 19h3v1h-3zM12 19h1v1h-1zM16 19h1v1h-1zM20 19h1v1h-1zM22 19h3v1h-3zM0 20h1v1h-1zM2 20h3v1h-3zM6 20h1v1h-1zM9 20h1v1h-1zM11 20h3v1h-3zM15 20h6v1h-6zM22 20h3v1h-3zM0 21h1v1h-1zM2 21h3v1h-3zM6 21h1v1h-1zM11 21h1v1h-1zM14 21h2v1h-2zM17 21h5v1h-5zM23 21h1v1h-1zM0 22h1v1h-1zM2 22h3v1h-3zM6 22h1v1h-1zM10 22h5v1h-5zM16 22h1v1h-1zM18 22h2v1h-2zM21 22h2v1h-2zM0 23h1v1h-1zM6 23h1v1h-1zM8 23h1v1h-1zM11 23h2v1h-2zM14 23h4v1h-4zM20 23h1v1h-1zM22 23h1v1h-1zM24 23h1v1h-1zM0 24h7v1h-7zM8 24h8v1h-8zM19 24h2v1h-2zM22 24h3v1h-3z"/></svg>
                                <span class="empty-text" id="empty-text">Enter a link to see your QR code here</span>
                            </div>
                        </div>
                        <p class="meta" id="meta"></p>
                        <p class="warn" id="warn" hidden></p>
                        <div class="size-row">
                            <span>PNG size</span>
                            <div class="seg seg-sm" id="f-size" role="radiogroup" aria-label="PNG size">
                                <button type="button" role="radio" data-v="512">512</button>
                                <button type="button" role="radio" data-v="1024">1024</button>
                                <button type="button" role="radio" data-v="2048">2048</button>
                            </div>
                        </div>
                        <div class="actions">
                            <button class="btn primary" id="dl-png" type="button">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                Download PNG
                            </button>
                            <button class="btn" id="dl-svg" type="button">SVG</button>
                            <button class="btn" id="copy" type="button">Copy</button>
                        </div>
                    </div>
                </div>
                <p class="tip">Tip: test-scan with your phone before you print. Keep strong contrast and leave a quiet zone around the code for the best results.</p>
            </aside>
        </div>

        <section class="features" aria-label="Features">
            <div class="feature">
                <span class="feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                <b>Private by design</b>
                <p>Nothing leaves your device. Wi-Fi passwords are never stored.</p>
            </div>
            <div class="feature">
                <span class="feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></svg></span>
                <b>Print-ready vectors</b>
                <p>SVG export stays sharp on posters, menus and business cards.</p>
            </div>
            <div class="feature">
                <span class="feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 8-4 4 4 4M15 8l4 4-4 4"/></svg></span>
                <b>Free and open source</b>
                <p>No watermarks, no expiry. The code is on GitHub for anyone to use.</p>
            </div>
        </section>
    </main>

    <div class="toast" id="toast" role="status" hidden></div>
</template>
